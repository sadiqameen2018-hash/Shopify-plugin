# Filled in automatically by `shopify app dev`. Set them yourself in production.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://your-app.example.com
SCOPES=read_orders,write_orders

# WhatsApp Cloud API (Meta for Developers > your app > WhatsApp > API Setup)
# Shared number used for all stores that don't add their own.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Meta app secret, used to verify webhook signatures.
WHATSAPP_APP_SECRET=
# Any random string; enter the same value in Meta's webhook settings.
WHATSAPP_VERIFY_TOKEN=
# Optional, defaults to v21.0
# WHATSAPP_GRAPH_VERSION=v21.0

# Secret for the reminder job: POST /jobs/run with "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=

# Use test charges in production (for App Store review). Remove after approval.
# BILLING_TEST=true

# Shown on the public privacy policy page (/privacy)
APP_COMPANY_NAME=
SUPPORT_EMAIL=
